# Synthesis check for generated PeakRDL-etana RTL (invoked from each test dir via make yosys).
# Uses Yosys built-in read_slang (sv-elab); read_verilog -sv cannot parse unpacked array ports.
# The yosys recipe in tests.mak reads the sources before it runs this script.

# Elaborate design hierarchy
hierarchy -check -top regblock

# Translate processes (always blocks)
proc

# Perform high-level optimizations
opt

# Flatten design (optional - comment out to keep hierarchy)
# flatten

# Technology mapping to simple gates
techmap

# Final optimizations
opt

# Display statistics
stat

# Write synthesized netlist
write_verilog -noattr synth-rtl/regblock_synth.v
