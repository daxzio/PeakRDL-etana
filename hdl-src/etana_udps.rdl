/*
 * This file defines several property extensions that are understood by the
 * PeakRDL-Etana SystemVerilog code generator.
 *
 * Compile this file prior to your other SystemRDL sources.
 *
 * For more details, see: https://peakrdl-etana.readthedocs.io/en/latest/udps/intro.html
 */

property verilog_reg_only {
    component = reg;
    type = boolean;
};

property err_support {
    component = mem;
    type = boolean;
};

property early_external_read {
    component = mem;
    type = boolean;
};

property cdc_clk {
    component = reg;
    type = ref;
};

property cdc_fast {
    component = signal;
    type = boolean;
};

property cdc_fast_mode_en {
    component = signal;
    type = boolean;
};

property cdc_nstages {
    component = signal;
    type = longint;
};
